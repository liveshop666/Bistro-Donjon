<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 et plus : l'écran de démarrage du système montre normalement l'icône de l'appli.
         On le laisse noir et vide (demande de Rudy, 15/11) : le jeu affiche ensuite son propre chargement. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_vide</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vide</item>
    </style>
</resources>
